{
  "name": "@sudobility/music_client",
  "version": "0.4.100",
  "description": "Typed network client + React Query hooks for the ScoreSmith music_api",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "clean": "rimraf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "keywords": [
    "music",
    "scoresmith",
    "api-client",
    "react-query"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/di": "^1.5.82",
    "@sudobility/music_types": "^0.13.59",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": ">=5",
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@sudobility/music_types": "^0.13.59",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitejs/plugin-react": "~6.1.2",
    "ajv": "~8.20.0",
    "eslint": "~10.13.0",
    "globals": "~17.13.0",
    "jsdom": "~30.1.3",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "rimraf": "~6.1.3",
    "typescript": "~6.0.3",
    "vite": "~8.3.5",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/music_client.git"
  }
}
